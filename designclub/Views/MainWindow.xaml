<Window x:Class="designclub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        xmlns:local="clr-namespace:designclub"
        mc:Ignorable="d"
        AllowsTransparency="True"
        WindowStyle="None"
        MouseMove="Window_MouseMove"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Title="Club" FontFamily="Bahnschrift"
        Width="1920" Height="1080" >
    <Window.Resources>
        
        
        <Style x:Key="FocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2" StrokeDashArray="1 2" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" SnapsToDevicePixels="true" StrokeThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="Button.Static.Background" Color="#FFDDDDDD"/>
        <SolidColorBrush x:Key="Button.Static.Border" Color="#FF707070"/>
        <SolidColorBrush x:Key="Button.MouseOver.Background" Color="#FFBEE6FD"/>
        <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#FF3C7FB1"/>
        <SolidColorBrush x:Key="Button.Pressed.Background" Color="#FFC4E5F6"/>
        <SolidColorBrush x:Key="Button.Pressed.Border" Color="#FF2C628B"/>
        <SolidColorBrush x:Key="Button.Disabled.Background" Color="#FFF4F4F4"/>
        <SolidColorBrush x:Key="Button.Disabled.Border" Color="#FFADB2B5"/>
        <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#FF838383"/>
        <Style x:Key="ButtonStyle1" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Background" Value="{StaticResource Button.Static.Background}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                            <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefaulted" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" TargetName="border" Value="#ff4d4d"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="#ff4d4d"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Background" TargetName="border" Value="#ff4d4d"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="#ff4d4d"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Background" TargetName="border" Value="#ff4d4d"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                                <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

      
        <Style x:Key="FocusVisual1">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2" StrokeDashArray="1 2" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" SnapsToDevicePixels="true" StrokeThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            
        </Style>
        <SolidColorBrush x:Key="Button.Static.Background1" Color="Transparent"/>
        <SolidColorBrush x:Key="Button.Static.Border1" Color="Transparent"/>
        <SolidColorBrush x:Key="Button.MouseOver.Background1" Color="Transparent"/>
        <SolidColorBrush x:Key="Button.MouseOver.Border1" Color="Transparent"/>
        <SolidColorBrush x:Key="Button.Pressed.Background1" Color="Transparent"/>
        <SolidColorBrush x:Key="Button.Pressed.Border1" Color="Transparent"/>
        <SolidColorBrush x:Key="Button.Disabled.Background1" Color="Transparent"/>
        <SolidColorBrush x:Key="Button.Disabled.Border1" Color="Transparent"/>
        <SolidColorBrush x:Key="Button.Disabled.Foreground1" Color="Transparent"/>
        <Style x:Key="ButtonStyle2" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual1}"/>
            <Setter Property="Background" Value="{StaticResource Button.Static.Background1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border1}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Template">
                
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                            <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefaulted" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                
                                <Setter Property="Background" TargetName="border" Value="#ff4d4d"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.MouseOver.Border1}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Pressed.Background1}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Pressed.Border1}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background1}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border1}"/>
                                <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Анимация для появления слева и исчезновения справа -->
        <Storyboard x:Key="ShowNotificationAnimation">
            <!-- Анимация для выезда с левой стороны -->
            <DoubleAnimation Storyboard.TargetName="ErrorPopupBorder"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-300" To="0"
                             Duration="0:0:0.3"/>

            <!-- Анимация "истекания" нижней линии -->
            <DoubleAnimation Storyboard.TargetName="BottomLine"
                             Storyboard.TargetProperty="Width"
                             From="0" To="200"
                             Duration="0:0:2"
                             BeginTime="0:0:0.3"/>

            <!-- Задержка перед анимацией ухода вправо -->
            <DoubleAnimation Storyboard.TargetName="ErrorPopupBorder"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="300"
                             Duration="0:0:0.3"
                             BeginTime="0:0:3"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <MediaElement Name="VideoPlayer" 
               LoadedBehavior="Play" 
               UnloadedBehavior="Stop" 
               Stretch="UniformToFill" 
               Source="pack://siteoforigin:,,,/Assets/game.mp4" />
        <!-- Фоновое изображение -->
        <Border x:Name="DimLayer" Background="Black" Opacity="0.75" Visibility="Collapsed" MouseDown="DimLayer_MouseDown"/>
       
        <Popup x:Name="AuthPopup" AllowsTransparency="True" IsOpen="False" Placement="Center">
            <Border Background="White" Width="500" Height="390" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Авторизация" FontSize="20" FontWeight="Bold" Margin="0,0,0,30" HorizontalAlignment="Center"/>
                    <Label HorizontalAlignment="Left">Логин</Label>
                    <TextBox x:Name="Login" Margin="0,0,0,0"/>
                    <Label HorizontalAlignment="Left">Пароль</Label>
                    <TextBox x:Name="Password" Margin="0,0,0,0"/>

                    <Button  x:Name="LoginButton"  Style="{DynamicResource ButtonStyle1}"  BorderBrush="#ff4d4d" Background="Transparent"  Width="140" Height="50" Content="Войти" Margin="0,44,0,0" HorizontalAlignment="Center" Click="LoginButton_Click"/>
                    <TextBlock Text="Просмотр интерфейса без базы данных" Margin="0,16,0,4" HorizontalAlignment="Center" Foreground="#666666"/>
                    <Button Style="{DynamicResource ButtonStyle1}" BorderBrush="#6d5ad7" Background="Transparent" Width="210" Height="38" Content="Демо: администратор" HorizontalAlignment="Center" Click="DemoAdminButton_Click"/>
                    <Button Style="{DynamicResource ButtonStyle1}" BorderBrush="#6d5ad7" Background="Transparent" Width="210" Height="38" Content="Демо: клиент" Margin="0,8,0,0" HorizontalAlignment="Center" Click="DemoClientButton_Click"/>

                   
                </StackPanel>
                
            </Border>
        </Popup>
        
        
        <TextBlock x:Name="MovingText" Text="SABUROV" 
                   FontSize="300" 
                   FontWeight="Bold" 
                   Foreground="White" 
                   Opacity="0.1"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top" 
                   RenderTransformOrigin="0.5,0.5" Margin="245,180,0,0">
            <!-- Легкий наклон текста для создания акцента -->
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="TextTransform"/>
            </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock Text="SABUROV CLUB" Foreground="#ff4d4d" FontSize="50" FontWeight="Bold" Margin="46,76,1627,876" TextWrapping="Wrap"/>
        <!-- Боковая панель навигации -->
        <StackPanel HorizontalAlignment="Left" Width="159" Background="Transparent" Margin="46,349,0,365">

            <Button Style="{DynamicResource ButtonStyle2}" Content="О НАС"  FontSize="25" Foreground="White" />
            <Button Content="ФОТО" Style="{DynamicResource ButtonStyle2}" FontSize="25"  />
            <Button Content="ЦЕНЫ" Style="{DynamicResource ButtonStyle2}" FontSize="25" />
            <Button Content="СОБЫТИЯ" Style="{DynamicResource ButtonStyle2}" FontSize="25" />
            <Button Content="КОНТАКТЫ" Style="{DynamicResource ButtonStyle2}" FontSize="25" />
            <Button Content="ИНФО" Style="{DynamicResource ButtonStyle2}"  FontSize="25" />
        </StackPanel>

        <!-- Основной контент -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="298,0,0,0">
            <TextBlock Text="КОМПЬЮТЕРНЫЙ КЛУБ" FontSize="130" FontWeight="Bold" Foreground="White" TextAlignment="Left"  TextWrapping="Wrap" Width="1529" Height="345" FontFamily="Arial Black"/>
            <TextBlock Text="Saburov CLUB - это один из лучших компьютерных клубов" 
                       TextWrapping="Wrap" FontSize="25" Foreground="White" TextAlignment="Left" HorizontalAlignment="Left" Margin="0,20,0,0" Width="815" Height="69"/>
            <Grid>
                <Button  Click="BookingButton_Click"  Style="{DynamicResource ButtonStyle1}" Content="Войти" FontSize="44" Width="372" Height="103" Margin="0,30,0,0" Foreground="White" BorderBrush="#ff4d4d" Background="Transparent"  HorizontalAlignment="Left"/>
                <Button Style="{DynamicResource ButtonStyle1}" Content="Выйти" FontSize="44" Width="372" Height="103" Margin="462,30,0,0" Foreground="White" BorderBrush="#ff4d4d" Background="Transparent"  HorizontalAlignment="Left" Click="Button_Click"/>
            </Grid>
            
        </StackPanel>

        




        <!--<Canvas>
            <TextBlock  x:Name="AnimatedTextBlock" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="50" Foreground="White" FontFamily="Segoe UI Black" Canvas.Left="50" Canvas.Top="118">
            КЛУБ SABUROV
            </TextBlock>
        </Canvas>

        <Canvas>
            <Button  x:Name="LoginButton" Style="{DynamicResource ButtonStyle1}" BorderBrush="#ff4d4d" BorderThickness="2" Content="Войти"  HorizontalAlignment="Left" VerticalAlignment="Center" Height="67" Width="142" Background="Transparent" Foreground="White" FontSize="18" Click="AnimatedButton_Click" Canvas.Left="92" Canvas.Top="220"/>
            <Button x:Name="RegistorButton" Style="{DynamicResource ButtonStyle1}" BorderBrush="#ff4d4d" BorderThickness="2" Content="Регистрация"  HorizontalAlignment="Left" VerticalAlignment="Top" Height="67" Width="142" Background="Transparent" Foreground="White" FontSize="18" Canvas.Left="270" Canvas.Top="220"/>
        </Canvas>-->


    </Grid>
</Window>
