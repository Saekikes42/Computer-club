<Window x:Class="designclub.AddEditServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:designclub"
        mc:Ignorable="d"
         Title="Добавление/Редактирование услуги" Height="260" Width="400">

    <Grid>
        <StackPanel Margin="10">
            <!-- Название услуги -->
            <TextBox x:Name="ServiceNameTextBox" Width="350" Text="Название услуги" Margin="0,10,0,0"/>

            <!-- Тип услуги -->
            <ComboBox x:Name="ServiceTypeComboBox" Width="350" Margin="0,10,0,0">
                <ComboBoxItem Content="PC"/>
                <ComboBoxItem Content="Console"/>
                <ComboBoxItem Content="VR"/>
            </ComboBox>

            <!-- Описание услуги -->
            <TextBox x:Name="ServiceDescriptionTextBox" Width="350" Text="Описание услуги" Margin="0,10,0,0"/>

            <!-- Количество минут -->
            <TextBox x:Name="ServiceMinutesTextBox" Width="350" Text="Минуты аренды" Margin="0,10,0,0"/>

            <!-- Стоимость за минуту -->
            <TextBox x:Name="ServiceCostTextBox" Width="350" Text="Стоимость за минуту" Margin="0,10,0,0"/>

            <!-- Кнопки для сохранения и отмены -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Сохранить" Click="SaveButton_Click" Width="150" Margin="0,10,10,0"/>
                <Button Content="Отмена" Click="CancelButton_Click" Width="150" Margin="0,10,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
