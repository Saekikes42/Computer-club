<Window x:Class="designclub.BookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:designclub"
        mc:Ignorable="d"
        Title="BookingWindow" Height="350" Width="400"
         WindowStyle="None"
        ResizeMode="NoResize"
        Background="White"
        AllowsTransparency="True"
        Opacity="0.95">
    <Grid>
        
        <StackPanel>
            <TextBlock Text="Бронирование" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            <TextBox Text="Введите имя" Margin="0,10,0,0"/>
            <TextBox Text="Введите номер телефона" Margin="0,10,0,0"/>
            <DatePicker Margin="0,10,0,0"/>
            <Button Content="Забронировать" Margin="0,20,0,0" HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Window>
