<Window x:Class="designclub.EditClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:designclub"
        mc:Ignorable="d"
        Title="EditClientWindow" Height="358" Width="377">
    <Grid>
        <!-- Разметка для редактирования клиента -->
        <StackPanel>
            <!-- ФИО -->
            <TextBlock Text="ФИО:" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10,0,0,0" FontSize="14"/>
            <TextBox Name="ClientNameTextBox" Width="200" Height="25" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" />

        <!-- Телефон -->
            <TextBlock Text="Телефон:" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10,0,0,0" FontSize="14"/>
            <TextBox Name="ClientPhoneTextBox" Width="200" Height="25" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,0" />



        <!-- Бонусный баланс -->
            <TextBlock Text="Бонусный баланс:" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10,0,0,0" FontSize="14"/>
        <TextBox Name="ClientBonusBalanceTextBox" Width="200" Height="25" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,0" />

            <TextBlock Text="Логин:" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10,0,0,0" FontSize="14"/>
            <TextBox Name="ClientLoginTextBox" Width="200" Height="25" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" />

            <TextBlock Text="Пароль:" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10,0,0,0" FontSize="14"/>
            <TextBox Name="ClientPasswordBox" Width="200" Height="25" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" />

        <!-- Кнопки Сохранить и Отменить -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
            <Button Name="SaveButton" Content="Сохранить" Width="100" Height="30" Margin="10" Click="SaveButton_Click"/>
            <Button Name="CancelButton" Content="Отменить" Width="100" Height="30" Margin="10" Click="CancelButton_Click"/>
        </StackPanel>
        </StackPanel>
        
    </Grid>
</Window>
